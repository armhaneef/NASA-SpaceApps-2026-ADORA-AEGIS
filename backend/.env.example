# JSON array of exact browser origins; restart the backend after changing.
AEGIS_CORS_ORIGINS='["http://localhost:5173","http://localhost:5175"]'
# Optional absolute path override; default is backend/aegis.sqlite3.
AEGIS_DATABASE_PATH=C:\\Temp\\aegis-adora-demo.sqlite3
# Optional Member 3 assistant service. The assistant must run separately on port 8001.
AEGIS_ASSISTANT_URL=http://127.0.0.1:8001
AEGIS_ASSISTANT_TIMEOUT_SECONDS=3
# .env files are not automatically loaded. Use process environment settings,
# or run Uvicorn with --env-file .env using the existing standard dependencies.
