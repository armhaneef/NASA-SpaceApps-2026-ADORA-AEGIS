# Copy to the ignored local .env file, then set OPENAI_API_KEY locally.
# Never commit .env or paste an API key into chat.
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=replace-locally
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=600
LLM_MAX_RETRIES=1
AI_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
VOICE_MICROPHONE_ENABLED=true
VOICE_SPEAK_ENABLED=true
# To use Gemini Developer API, select this provider after confirming your
# Google AI Studio project has Gemini 2.5 Flash access on its Free Tier.
# LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
